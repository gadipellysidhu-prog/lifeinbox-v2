# ==============================================================================
# LifeInbox Environment Configuration Template (.env.example)
# Copy this file to .env and configure values for your environment.
# DO NOT commit real secrets or production credentials to source control.
# ==============================================================================

# Database Configuration (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=lifeinbox
DB_USER=postgres
DB_PASSWORD=postgres

# Backend Server Configuration
SERVER_PORT=8080
SERVER_ADDRESS=127.0.0.1
SPRING_PROFILES_ACTIVE=dev

# JWT Authentication Configuration
# Generate a cryptographically secure 256-bit+ secret for production
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_EXPIRATION_MS=86400000

# Frontend Configuration (Vite)
# Leave empty in local dev to use Vite proxy (/api), or specify URL for direct connection
VITE_API_URL=
BACKEND_URL=http://localhost:8080

# Email Delivery Configuration (Resend API - Production & Default)
# Sign up at https://resend.com and generate an API key (re_...)
RESEND_API_KEY=
RESEND_FROM_EMAIL=LifeInbox <onboarding@resend.dev>

# Email Provider: 'resend' (default) or 'smtp'
EMAIL_PROVIDER=resend

# Legacy Email (SMTP) Configuration (Optional - only needed if EMAIL_PROVIDER=smtp)
# For local development with MailHog:
# Host is 'localhost' when running Spring Boot directly on host machine, or 'mailhog' when running in docker container
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=noreply@lifeinbox.local
MAIL_FROM_NAME=LifeInbox
MAIL_PROTOCOL=smtp
MAIL_SMTP_AUTH=true
MAIL_SMTP_STARTTLS=true

# Application Public Base URL (used in email action links)
APP_BASE_URL=http://localhost:5173

# Scheduler & Delivery Configuration
LIFEINBOX_SCHEDULER_REMINDER_INTERVAL_MS=30000
LIFEINBOX_SCHEDULER_DIGEST_INTERVAL_MS=60000
EMAIL_MAX_RETRIES=3
EMAIL_RETRY_BACKOFF_SECONDS=60

# Web Push (VAPID) Configuration
# Enable or disable browser push notifications
LIFEINBOX_PUSH_ENABLED=false
# VAPID Public Key (uncompressed P-256 point in base64url format, safe for clients)
VAPID_PUBLIC_KEY=
# VAPID Private Key (scalar in base64url format, SERVER ONLY - NEVER EXPOSE OR COMMIT)
VAPID_PRIVATE_KEY=
# VAPID Subject (mailto: or https: URL identifying the application operator to push services)
VAPID_SUBJECT=mailto:admin@lifeinbox.local

# Web Push Retry Configuration
LIFEINBOX_PUSH_RETRY_ENABLED=true
LIFEINBOX_PUSH_RETRY_MAX_ATTEMPTS=3
LIFEINBOX_PUSH_RETRY_INITIAL_BACKOFF_MS=1000
LIFEINBOX_PUSH_RETRY_MAX_BACKOFF_MS=10000

